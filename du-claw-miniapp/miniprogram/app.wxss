/* du-claw 全局样式 - 深色科技风主题 */

page {
  background-color: #0f0f23;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ===== 卡片 ===== */
.card {
  background-color: #1a1a2e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(108, 99, 255, 0.15);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #a0a0b8;
  line-height: 1.5;
}

/* ===== 按钮 ===== */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6c63ff, #8b7cff);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #6c63ff;
  border: 2rpx solid #6c63ff;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-outline:active {
  background: rgba(108, 99, 255, 0.1);
}

.btn-small {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  background: rgba(108, 99, 255, 0.15);
  color: #8b7cff;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: rgba(108, 99, 255, 0.3);
  color: #b3a8ff;
}

.tag-success {
  background: rgba(46, 213, 115, 0.15);
  color: #2ed573;
}

.tag-warning {
  background: rgba(255, 165, 0, 0.15);
  color: #ffa500;
}

.tag-danger {
  background: rgba(255, 71, 87, 0.15);
  color: #ff4757;
}

/* ===== 强调色文字 ===== */
.text-primary {
  color: #6c63ff;
}

.text-muted {
  color: #8888a0;
}

.text-white {
  color: #ffffff;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 20rpx 0;
}

/* ===== 加载动画 ===== */
.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
}

.loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #6c63ff;
  border-radius: 50%;
  animation: dotBounce 1.4s ease-in-out infinite both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== 通用空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #666;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}