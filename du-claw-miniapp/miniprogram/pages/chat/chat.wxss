/* 对话页样式 */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0f0f23;
}

/* ===== 顶部导航栏 ===== */
.chat-header {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #1a1a2e;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  z-index: 10;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #8888a0;
  line-height: 1;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.header-scene {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.header-subtitle {
  font-size: 22rpx;
  color: #7878a0;
  margin-top: 2rpx;
}

.header-action {
  flex-shrink: 0;
}

.new-chat-btn {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: rgba(108, 99, 255, 0.15);
  color: #6c63ff;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* ===== 消息列表 ===== */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 28rpx;
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-assistant {
  flex-direction: row;
}

/* 头像 */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin: 0 12rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.15);
}

.msg-avatar-user {
  background: rgba(108, 99, 255, 0.15);
}

/* 气泡 */
.msg-bubble {
  max-width: 65%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  word-break: break-all;
  line-height: 1.6;
}

.bubble-user {
  background: linear-gradient(135deg, #6c63ff, #5548d9);
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 99, 255, 0.3);
}

.bubble-assistant {
  background: #1a1a2e;
  color: #e0e0e0;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.msg-rich {
  font-size: 28rpx;
  line-height: 1.7;
}

/* ===== 提醒确认条 ===== */
.remind-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(108, 99, 255, 0.08);
  border-radius: 10rpx;
  border-left: 4rpx solid #6c63ff;
}

.remind-text {
  font-size: 22rpx;
  color: #b0b0c8;
  flex: 1;
}

.remind-actions {
  display: flex;
  gap: 12rpx;
  margin-left: 12rpx;
}

.remind-btn {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.remind-confirm {
  background: #6c63ff;
  color: #ffffff;
}

.remind-cancel {
  color: #8888a0;
  border: 1rpx solid #444;
}

/* ===== 底部输入区 ===== */
.input-area {
  background: #1a1a2e;
  padding: 12rpx 20rpx 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.remain-hint {
  text-align: center;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #7878a0;
}

.remain-num {
  color: #6c63ff;
  font-weight: 600;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.msg-input {
  flex: 1;
  background: #13132a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  max-height: 200rpx;
  min-height: 72rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.1);
  line-height: 1.5;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2a2a3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #555;
  transition: all 0.2s;
  flex-shrink: 0;
}

.send-active {
  background: linear-gradient(135deg, #6c63ff, #5548d9);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(108, 99, 255, 0.4);
}

.send-disabled {
  opacity: 0.5;
  pointer-events: none;
}