/* 我的页面样式 */

/* ===== 用户信息区 ===== */
.user-header {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.user-gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4a 40%, #6c63ff 100%);
  opacity: 0.9;
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  z-index: 1;
}

.user-avatar-wrap {
  margin-right: 20rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.user-avatar-placeholder {
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.user-edit {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
}

/* ===== 统计区 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.stats-section {
  margin-bottom: 28rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stat-item {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: calc(33.33% - 8rpx);
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #6c63ff;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #7878a0;
  text-align: center;
}

/* ===== 套餐列表 ===== */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.plan-card {
  position: relative;
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: all 0.2s;
}

.plan-card:active {
  background: rgba(108, 99, 255, 0.06);
}

.plan-recommended {
  border: 2rpx solid #6c63ff;
  background: rgba(108, 99, 255, 0.06);
}

.plan-badge {
  position: absolute;
  top: -1rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #6c63ff, #a78bfa);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 0 0 10rpx 10rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.plan-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.12);
}

.plan-features {
  display: flex;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
  margin: 0 16rpx;
}

.plan-feat {
  font-size: 20rpx;
  color: #8888a0;
}

.plan-footer {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.plan-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.plan-unit {
  font-size: 22rpx;
  color: #7878a0;
  margin-left: 2rpx;
}

/* ===== 菜单 ===== */
.menu-section {
  margin-bottom: 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #1a1a2e;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
}

.menu-text {
  font-size: 28rpx;
  color: #e0e0e0;
}

.menu-arrow {
  font-size: 32rpx;
  color: #555;
}

/* ===== 关于 ===== */
.about-section {
  text-align: center;
  padding: 32rpx 0;
  margin-bottom: 40rpx;
}

.about-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.about-text {
  display: block;
  font-size: 22rpx;
  color: #7878a0;
  margin-bottom: 6rpx;
}

.about-copyright {
  display: block;
  font-size: 20rpx;
  color: #555;
  margin-top: 16rpx;
}