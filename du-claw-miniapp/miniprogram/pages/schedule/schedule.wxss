/* 日程提醒中心样式 */

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: #1a1a2e;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #7878a0;
  transition: all 0.2s;
  position: relative;
}

.tab-active {
  color: #ffffff;
  font-weight: 600;
  background: rgba(108, 99, 255, 0.15);
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #6c63ff;
  border-radius: 2rpx;
}

/* ===== 提醒列表 ===== */
.schedule-list {
  padding-bottom: 120rpx;
}

.schedule-card {
  display: flex;
  align-items: flex-start;
  background: #1a1a2e;
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: all 0.2s;
}

.schedule-card:active {
  background: rgba(108, 99, 255, 0.05);
}

.schedule-done {
  opacity: 0.5;
}

.schedule-done .schedule-title {
  text-decoration: line-through;
  color: #666;
}

.schedule-status {
  padding-top: 4rpx;
  margin-right: 16rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-pending {
  background: #6c63ff;
  box-shadow: 0 0 10rpx rgba(108, 99, 255, 0.5);
}

.dot-done {
  background: #2ed573;
}

.schedule-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.schedule-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.4;
}

.schedule-desc {
  font-size: 24rpx;
  color: #8888a0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.schedule-time {
  font-size: 22rpx;
  color: #6c63ff;
  margin-top: 2rpx;
}

.schedule-check {
  font-size: 28rpx;
  color: #2ed573;
  padding-top: 4rpx;
  padding-left: 12rpx;
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  bottom: 48rpx;
  right: 40rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #5548d9);
  box-shadow: 0 8rpx 28rpx rgba(108, 99, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  line-height: 1;
}

/* ===== 创建弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
}

.modal-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #1a1a2e;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 40rpx;
  z-index: 201;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 24rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #8888a0;
  margin-bottom: 8rpx;
}

.form-input {
  background: #13132a;
  border: 1rpx solid rgba(108, 99, 255, 0.1);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
}

.form-textarea {
  background: #13132a;
  border: 1rpx solid rgba(108, 99, 255, 0.1);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #e0e0e0;
  min-height: 120rpx;
}

.form-picker {
  background: #13132a;
  border: 1rpx solid rgba(108, 99, 255, 0.1);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #6c63ff;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}